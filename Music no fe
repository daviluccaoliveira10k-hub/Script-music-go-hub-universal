-- ===== ANIMAÇÃO SINCRONIZADA COM A MÚSICA =====
local heights = {}
local targets = {}
local phases = {}
for i = 1, NUM_BARS do
	heights[i] = 6
	targets[i] = 6
	phases[i] = math.random() * math.pi * 2
end

local MAX_H = 340
local MIN_H = 6

RunService.RenderStepped:Connect(function(dt)
	local playing = sound.IsPlaying and sound.Playing
	local loudness = 0

	if playing then
		loudness = sound.PlaybackLoudness / 1000
	end

	for i = 1, NUM_BARS do
		if playing then
			local center = NUM_BARS / 2
			local distFromCenter = math.abs(i - center) / center
			local base = (1 - distFromCenter * 0.5)

			phases[i] = phases[i] + dt * (3 + i * 0.3)
			local wave = (math.sin(phases[i]) * 0.5 + 0.5) * 0.4 + 0.6

			targets[i] = loudness * base * wave * MAX_H
		else
			targets[i] = MIN_H
		end

		-- sobe rápido, cai devagar
		local speed = targets[i] > heights[i] and 0.7 or 0.15
		heights[i] = heights[i] + (targets[i] - heights[i]) * speed

		local bar = bars[i]
		bar.Size = UDim2.new(0, 40, 0, math.max(MIN_H, heights[i]))

		local ratio = math.clamp(heights[i] / MAX_H, 0, 1)
		local r = math.clamp(ratio * 2, 0, 1)
		local g = math.clamp(2 - ratio * 2, 0, 1)
		bar.BackgroundColor3 = Color3.new(r, g, 0.2)
	end
end)

