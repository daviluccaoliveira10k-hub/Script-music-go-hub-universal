-- ===== SEGUIR / FIXO =====
local following = true

local function getHRP()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function snapToFront()
	local hrp = getHRP()
	if not hrp then return end
	part.Position = (hrp.CFrame * CFrame.new(0, 1, -9)).Position
end
snapToFront()

player.CharacterAdded:Connect(function()
	task.wait(0.2)
	snapToFront()
end)

menuBtn.MouseButton1Click:Connect(function()
	following = not following
	local color = following and Color3.fromRGB(0, 220, 120) or Color3.fromRGB(180, 180, 180)
	for _, bar in ipairs(menuBtn:GetChildren()) do
		if bar:IsA("Frame") then
			bar.BackgroundColor3 = color
		end
	end
	if following then snapToFront() end
end)

RunService.RenderStepped:Connect(function()
	local hrp = getHRP()
	if not hrp then return end

	if following then
		local targetPos = (hrp.CFrame * CFrame.new(0, 1, -9)).Position
		part.Position = part.Position:Lerp(targetPos, 0.15)
	end

	local lookAt = hrp.Position + Vector3.new(0, 1, 0)
	part.CFrame = CFrame.lookAt(part.Position, lookAt)
end)
